{
  "name": "dsh-desktop-electron",
  "private": true,
  "version": "0.1.1",
  "description": "DSH Desktop Shell",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dsh.desktop-shell",
    "productName": "DSH Desktop Shell",
    "directories": { "output": "dist" },
    "files": ["**/*", "!**/dist/**", "!**/dist-new/**", "!**/dist-tmp/**", "!**/dist_old/**", "!**/dist-locked-old/**", "!**/.pnpm-store/**", "!**/out/**"],
    "extraResources": [{ "from": "build/icon.png", "to": "build/icon.png" }],
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
